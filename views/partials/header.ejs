<%#
  views/partials/header.ejs
  Shared top part of every page: <head>, fonts, CSS and the sticky navbar.
  Included at the top of each page with: include('partials/header')
  NOTE: the "equals" output tag in EJS escapes HTML automatically (like
  htmlspecialchars() in PHP), so data typed by users can never inject HTML or scripts.
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= site.CAMPUS_NAME %></title>
  <meta name="description" content="<%= site.CAMPUS_NAME %> - diplomas, HND and certificate courses in ICT, business, English and design.">
  <meta name="theme-color" content="#14223f">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <!-- Google Fonts: Fraunces for headings, Manrope for body text -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= admin ? 'is-admin' : 'is-public' %>">
  <!-- Skip link: lets keyboard users jump straight to the content -->
  <a class="skip-link" href="#main">Skip to content</a>

<% if (admin) { %>
  <%# ================= ADMIN LAYOUT: sidebar + content ================= %>
  <%
    const adminLinks = [
      ['/dashboard', 'Dashboard', 'dashboard'],
      ['/register',  'Register',  'register'],
      ['/search',    'Search',    'search'],
      ['/update',    'Update',    'update'],
      ['/delete',    'Delete',    'delete']
    ];
  %>
  <!-- Top bar: only shown on phones and tablets -->
  <header class="admin-topbar">
    <a class="brand" href="/dashboard">
      <img src="/images/logo.png" alt="" width="36" height="36">
      <span><%= site.CAMPUS_NAME %></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="admin-sidebar">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      <span class="sr-only">Menu</span>
    </button>
  </header>

  <!-- Sidebar: fixed on the left on desktop, slides in on phones -->
  <aside id="admin-sidebar" class="sidebar">
    <a class="brand sidebar-brand" href="/dashboard">
      <img src="/images/logo.png" alt="" width="40" height="40">
      <span><%= site.CAMPUS_NAME %><small>Admin panel</small></span>
    </a>
    <nav class="side-nav" aria-label="Admin">
      <p class="side-label">Menu</p>
      <% adminLinks.forEach(function (l) { %>
        <a href="<%= l[0] %>" class="<%= currentPath === l[0] ? 'active' : '' %>"><%- icon(l[2]) %><span><%= l[1] %></span></a>
      <% }); %>
      <p class="side-label">Website</p>
      <a href="/"><%- icon('home') %><span>View website</span></a>
    </nav>
    <div class="side-user">
      <span class="avatar"><%= admin.charAt(0).toUpperCase() %></span>
      <span class="side-user-name"><%= admin %><small>Administrator</small></span>
      <a href="/logout" class="side-logout" title="Log out"><%- icon('logout') %><span class="sr-only">Log out</span></a>
    </div>
  </aside>
<% } else { %>
  <!-- ===== PUBLIC LAYOUT: sticky navigation bar ===== -->
  <header class="navbar">
    <div class="wrap nav-inner">
      <a class="brand" href="/">
        <img src="/images/logo.png" alt="" width="40" height="40">
        <span><%= site.CAMPUS_NAME %></span>
      </a>

      <!-- Menu button: only visible on small screens (see style.css) -->
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        <span class="sr-only">Menu</span>
      </button>

      <nav id="nav-links" class="nav-links" aria-label="Main">
          <%# Links for public visitors %>
          <a href="/#about">About</a>
          <a href="/#courses">Courses</a>
          <a href="/#contact">Contact</a>
          <a href="/admin" class="btn btn-small btn-gold">Admin login</a>
      </nav>
    </div>
  </header>

<% } %>

  <main id="main" class="<%= admin ? 'admin-main' : '' %>">
