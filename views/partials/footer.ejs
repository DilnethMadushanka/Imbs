<%#
  views/partials/footer.ejs
  Shared bottom part of every page: footer + JavaScript file.
%>
<% if (admin) { %>
    <%# Admin pages: a small footer inside the content area %>
    <footer class="admin-footer">&copy; <%= new Date().getFullYear() %> <%= site.CAMPUS_NAME %> &middot; Admin panel</footer>
  </main>
<% } else { %>
  </main>

  <!-- ===== Footer: brand, links, programmes, contact ===== -->
  <footer class="footer">
    <div class="wrap footer-grid">
      <div class="footer-about">
        <a class="brand" href="/">
          <img src="/images/logo.png" alt="" width="40" height="40">
          <span><%= site.CAMPUS_NAME %></span>
        </a>
        <p>Diplomas, HNDs and certificates in computing, business, English and design.</p>
      </div>
      <div>
        <p class="footer-head">Explore</p>
        <ul class="footer-links">
          <li><a href="/#about">About</a></li>
          <li><a href="/#courses">Courses</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li><a href="/admin">Admin login</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-head">Visit</p>
        <ul class="footer-links">
          <li><%= site.CAMPUS_AREA %></li>
          <li><a href="mailto:<%= site.CAMPUS_EMAIL %>"><%= site.CAMPUS_EMAIL %></a></li>
          <li><%= site.CAMPUS_HOURS %></li>
        </ul>
      </div>
      <p class="footer-copy">&copy; <%= new Date().getFullYear() %> <%= site.CAMPUS_NAME %>. CIT1074 Web Application Development Project.</p>
    </div>
  </footer>
<% } %>

  <!-- Client-side validation, menu toggle and delete confirmation -->
  <script src="/js/main.js"></script>
</body>
</html>
