<%#
  views/dashboard.ejs  -  ADMIN DASHBOARD
  Stat tiles, students per course, recent registrations and quick actions.
  All numbers are worked out in routes/students.js.
%>
<%- include('partials/header') %>
<section class="page">
  <div class="wrap">
    <div class="page-head">
      <div>
        <p class="eyebrow"><%= today %></p>
        <h1>Welcome back, <%= admin %></h1>
      </div>
      <a class="btn btn-gold" href="/register"><%- icon('register') %> Register student</a>
    </div>

    <!-- ===== Stat tiles ===== -->
    <div class="stat-grid">
      <div class="stat-tile stat-tile-main">
        <span class="stat-icon"><%- icon('users') %></span>
        <span class="stat-value"><%= total %></span>
        <span class="stat-name">Students registered</span>
      </div>
      <div class="stat-tile">
        <span class="stat-icon"><%- icon('book') %></span>
        <span class="stat-value"><%= courseCount %></span>
        <span class="stat-name">Courses offered</span>
      </div>
      <div class="stat-tile">
        <span class="stat-icon"><%- icon('calendar') %></span>
        <span class="stat-value"><%= thisMonth %></span>
        <span class="stat-name">Registered this month</span>
      </div>
      <div class="stat-tile">
        <span class="stat-icon"><%- icon('gender') %></span>
        <span class="stat-value"><%= male %><span class="stat-sep">/</span><%= female %></span>
        <span class="stat-name">Male / Female</span>
      </div>
    </div>

    <div class="dash-panels">
      <!-- ===== Students per course: one bar per course ===== -->
      <section class="panel">
        <div class="panel-head">
          <h2>Students per course</h2>
        </div>
        <ul class="bar-list">
          <% perCourse.forEach(function (c) { %>
            <li title="<%= c.name %>: <%= c.count %> <%= c.count === 1 ? 'student' : 'students' %>">
              <div class="bar-label"><span><%= c.name %></span><strong><%= c.count %></strong></div>
              <div class="bar-track"><span class="bar-fill" style="width: <%= Math.round(c.count / maxCount * 100) %>%"></span></div>
            </li>
          <% }); %>
        </ul>
      </section>

      <!-- ===== Most recent registrations ===== -->
      <section class="panel">
        <div class="panel-head">
          <h2>Recently registered</h2>
          <a class="text-link" href="/search">View all <%- icon('arrow') %></a>
        </div>
        <% if (recent.length) { %>
          <ul class="recent-list">
            <% recent.forEach(function (s) { %>
              <li>
                <span class="avatar"><%= s.name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() %></span>
                <span class="recent-text">
                  <strong><%= s.name %></strong>
                  <small><%= s.course_name %></small>
                </span>
                <span class="recent-date"><%= new Date(s.reg_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="muted">No students yet. <a href="/register">Register the first one</a>.</p>
        <% } %>
      </section>
    </div>

    <!-- ===== Quick actions ===== -->
    <h2 class="section-title">Quick actions</h2>
    <div class="dash-grid">
      <a class="dash-card" href="/register">
        <span class="dash-icon"><%- icon('register') %></span>
        <h3>Register</h3>
        <p>Add a new student and assign a course.</p>
      </a>
      <a class="dash-card" href="/search">
        <span class="dash-icon"><%- icon('search') %></span>
        <h3>Search</h3>
        <p>Find students by NIC or name, or list them all.</p>
      </a>
      <a class="dash-card" href="/update">
        <span class="dash-icon"><%- icon('update') %></span>
        <h3>Update</h3>
        <p>Load a student by NIC and edit their details.</p>
      </a>
      <a class="dash-card dash-card-danger" href="/delete">
        <span class="dash-icon"><%- icon('delete') %></span>
        <h3>Delete</h3>
        <p>Remove a student record after confirming.</p>
      </a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
